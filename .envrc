export AWS_PROFILE=guestnote
export AWS_REGION=eu-central-1

# Node 24, from .nvmrc, without having to remember `nvm use`.
#
# .nvmrc alone only helps if your shell auto-switches on cd, and plenty do not -- an agent
# shell, a fresh terminal, CI, a `direnv exec` one-liner. Those land on whatever Node is
# default, which for this machine is 22, and .npmrc turns the resulting mismatch into an
# error rather than a silent no-op. This makes it not happen in the first place.
#
# `use node` is direnv's own, so nvm never has to be sourced; it just needs to be told
# where the versions live and how they are named. NODE_VERSIONS points at nvm's directory
# because that is what is installed here -- if you use fnm or asdf instead, repoint it.
export NODE_VERSIONS="${HOME}/.nvm/versions/node"
export NODE_VERSION_PREFIX=v
use node
