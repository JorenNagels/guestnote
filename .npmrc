# Turn the engines field in package.json into an error rather than a warning.
#
# Without this, running npm on the wrong Node prints `npm warn EBADENGINE` and then
# carries on -- and "carries on" can mean silently doing nothing at all. That is not
# hypothetical: on 2026-08-18 an `npm install` of a new dependency under Node 22 wrote
# the entry into package.json, skipped the install, and reported "up to date", leaving a
# dependency that existed in the manifest and nowhere on disk. The next command failed
# somewhere unrelated.
#
# `engines` is `>=24 <25` because the code uses Node 24 features -- native type stripping
# for the `.ts` extensions in tsconfig.base.json, and `--env-file`. A warning is the wrong
# severity for that.
engine-strict=true
