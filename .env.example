# Copy to .env.local and fill in. .env.local is gitignored; this file is not, and
# must never gain values. Secrets in deployed environments come from SSM Parameter
# Store SecureStrings at /guestnote/<env>/*, never from a committed file.

# ---------------------------------------------------------------- database ----
# Neon, aws-eu-central-1. Connect as `app_user` -- NOT the table owner, and without
# BYPASSRLS, or every RLS policy in packages/db/migrations silently does nothing.
#
# POOLED is what the app uses (the -pooler host). withTenant() needs interactive
# transactions, so it runs over the WebSocket/pooled driver.
DATABASE_URL=

# UNPOOLED is for drizzle-kit migrate only. DDL through a transaction-mode pooler
# is a bad time; run migrations against the direct endpoint.
DATABASE_URL_UNPOOLED=

# The Neon branch the `db` vitest project runs against. Point this at a throwaway
# branch, not at `main` -- the isolation suite writes fixtures and truncates.
# It must be the POOLED host: assertions 3 and 4 in packages/db/test/pooling.test.ts
# are about pooler behaviour and are meaningless against a direct connection.
TEST_DATABASE_URL=

# -------------------------------------------------------------------- auth ----
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
