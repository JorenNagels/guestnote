# Logs
logs
*.log
npm-debug.log*

# Dependencies and build output
node_modules
dist
dist-ssr
.next/
out/
*.tsbuildinfo
*.local

# Next.js. Regenerated by `next dev` / `next build` / `next typegen`; the docs say to
# gitignore it and never edit it by hand.
next-env.d.ts

# CDK
infra/cdk.out
cdk.out

# SST (ion). Deploy state lives in an S3 bucket in the AWS account, not here; these are
# local build/scratch only. `sst-env.d.ts` is regenerated by `sst` on every run.
.sst
.open-next
sst-env.d.ts

# Lambda build artifacts
*.zip

# Tests
coverage/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.sw?

# Environment. .env.example is committed, with keys and no values.
.env
.env.*
!.env.example

# Claude Code per-user state. Three deliberate exceptions:
#   .claude/settings.json  — pins AWS_PROFILE=guestnote. The `default` profile on
#     this machine is the employer's shared production account, so this file is a
#     guardrail, not a preference. It belongs in the repo.
#   .claude/skills/        — project-level skills, shared.
#   .claude/agents/        — project-level subagents, shared for the same reason. They
#     encode this repo's invariants (tenancy, the auth seam, the mutation discipline),
#     so they are documentation that happens to be executable, not a personal setting.
# Still excluded: settings.local.json (per-machine hook wiring, with absolute paths in it)
# and worktrees/, which is a second checkout of this repo.
.claude/*
!.claude/settings.json
!.claude/skills
!.claude/skills/**
!.claude/agents
!.claude/agents/**

# Rendered email from the development mail transport (apps/web/src/lib/mailer.ts).
# Contains live sign-in codes, so it must never be committed. The transport refuses to
# run outside development, which is the other half of keeping that true.
apps/web/.mail/

# Generated share image for the holding page; deploy.sh re-renders it from og.html.
coming-soon/og.png

# Impeccable (design skill) runtime state. `.impeccable/surfaces/` holds the surface
# briefs and IS documentation — it stays. Everything else here is per-machine or
# per-session: the question server's transcripts, and live-mode's injection targets.
.impeccable/questions/
.impeccable/live/

# design-sync: staged converter scripts, its deps, and the regenerated bundle.
# The durable inputs (.design-sync/config.json, NOTES.md, conventions.md, previews/)
# ARE committed -- they are what makes a later sync fast; everything below is derived.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
# Compiled from tokens.css + a Tailwind pass over packages/ui. One command to rebuild
# (.design-sync/build-css.mjs), and 19 KB of generated CSS in every diff otherwise.
packages/ui/.ds-preview.css
# Rendered artboards: 8 MB of PNG plus the PDF, all reproducible from export.mjs.
design-system/planner-canvas/_export/
