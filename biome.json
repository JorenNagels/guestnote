{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/cdk.out",
      "!**/migrations/meta",
      "!**/next-env.d.ts",
      "!coming-soon",
      "!waitlist",
      "!design-system",
      "!**/*.svg",
      "!sst-env.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "domains": {
      "react": "recommended",
      "next": "recommended",
      "test": "recommended"
    },
    "rules": {
      "preset": "recommended",
      "style": {
        "useConst": "error",
        "noNonNullAssertion": "error",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "better-auth": "Only packages/core/src/auth/better-auth.ts may import this. Everything else goes through the packages/core/auth seam, so swapping provider stays a bounded job. See research/07-auth-and-tenancy.md section 1.",
              "@guestnote/db/unsafe": "Bypasses tenant isolation. packages/db/** and the migration runner only. See research/05-architecture.md section 4.",
              "@aws-sdk/client-sesv2": "Only packages/email/src/ses.ts may import this (and its test, to construct the SDK error classes it maps). Everything else goes through the packages/email seam, so swapping mail provider stays a bounded job -- and so the AWS SDK cannot be pulled into a bundle by a stray import. See research/05-architecture.md section 6."
            }
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "error"
      },
      "nursery": {
        "noDrizzleDeleteWithoutWhere": "error",
        "noDrizzleUpdateWithoutWhere": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "packages/core/src/auth/better-auth.ts",
        "packages/email/src/ses.ts",
        "packages/email/src/ses.test.ts",
        "packages/db/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ]
}
